# Xiaomi 13T Android 16 properties (vendor.prop)
# Hardware Baseline: HyperOS 2 / MT6895 (Dimensity 8200 Ultra)
# Organized modularly by subsystem for clean maintenance.

# -----------------------------------------------------------------------------
# Graphics & Display HALs
# -----------------------------------------------------------------------------
ro.hardware.egl=mali
ro.hardware.vulkan=mali
ro.hardware.hwcomposer=mtk_common
ro.hardware.gralloc=common
ro.sf.lcd_density=480
ro.vendor.composer_version=2.3
ro.vendor.displayfeature.dump=false
ro.vendor.touchfeature.type=243
persist.vendor.EnableP3ColorSpace=1
debug.renderengine.backend=skiaglthreaded
debug.mediatek.disp_decompress=1
ro.vendor.mtk.gpud.mm.fbc.disable=false
ro.vendor.mtk.gpu.game_memc=1
ro.vendor.mtk.gpu.service=1

# -----------------------------------------------------------------------------
# SurfaceFlinger Core & Vsync Phase Durations (144Hz Optimized)
# -----------------------------------------------------------------------------
ro.vendor.mtk_ovl_bringup=0
# Use the ROM's vendor-camera stream handling for the bundled Xiaomi camera.
persist.vendor.camera.privapp.list=com.android.camera
# This ROM maps configured values >= 3 to an effective limit of 6.
ro.surface_flinger.max_frame_buffer_acquired_buffers=4
ro.surface_flinger.enable_frame_rate_override=false
ro.surface_flinger.game_default_frame_rate_override=120
debug.graphics.game_default_frame_rate.disabled=true
ro.surface_flinger.force_hwc_copy_for_virtual_displays=true
ro.surface_flinger.has_wide_color_display=true
ro.surface_flinger.protected_contents=true
ro.surface_flinger.supports_background_blur=1
ro.surface_flinger.uclamp.min=328
debug.sf.set_binder_thread_rt=1
ro.surface_flinger.set_idle_timer_ms=1500
ro.surface_flinger.set_touch_timer_ms=200
ro.surface_flinger.set_display_power_timer_ms=1000
# Use AutoSingleLayer so window transitions wait for ready buffers.
debug.sf.auto_latch_unsignaled=0
debug.sf.disable_backpressure=1
# Frame rate multiple threshold: Keep at 120 so content < 60 fps (e.g. 24/30 fps videos) 
# does not needlessly boost display to 120/144Hz, while UI and 60+ fps content can reach full 144Hz.
debug.sf.frame_rate_multiple_threshold=120
debug.sf.use_phase_offsets_as_durations=1
debug.sf.late.sf.duration=13800000
debug.sf.late.app.duration=10000000
debug.sf.early.sf.duration=13800000
debug.sf.early.app.duration=10000000
debug.sf.earlyGl.sf.duration=13800000
debug.sf.earlyGl.app.duration=13800000
debug.sf.hwc.min.duration=8500000
debug.sf.enable_gl_backpressure=0
# Reuse identical client compositions instead of submitting redundant RenderEngine work.
debug.sf.disable_client_composition_cache=0
debug.sf.enable_hwc_vds=0
debug.sf.latch_unsignaled=1
debug.sf.predict_hwc_composition_strategy=0
debug.sf.treat_170m_as_sRGB=1
vendor.debug.sf.dynamic_duration.app.decouple=20000000
vendor.debug.sf.dynamic_duration.app.early=18000000
vendor.debug.sf.dynamic_duration.app.early.144=5800000

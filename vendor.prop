persist.vendor.sys.fp.fod.size.width_height=210,210
persist.vendor.fingerprint.type=udfps_optical
ro.vendor.fingerprint.type=udfps_optical
persist.vendor.fingerprint.sensor_location=610|2444|105

# -----------------------------------------------------------------------------
# Platform, Security & System Services
# -----------------------------------------------------------------------------
ro.vendor.mediatek.platform=MT6895
ro.vendor.mediatek.version.branch=alps-mp-b0.mp1.tc8sp2
ro.vendor.mediatek.version.release=alps-mp-b0.mp1.tc8sp2-V1
ro.vendor.mgvi_name=mgvi_64_armv82
ro.vendor.rc=/vendor/etc/init/hw/
ro.vendor.init.sensor.rc=init.sensor_2_0.rc
ro.crypto.volume.filenames_mode=aes-256-cts
ro.vendor.mtk_f2fs_enable=1
ro.vendor.mtk_eccci_c2k=1
ro.vendor.mtk_mcf_support=1
persist.vendor.meta.connecttype=usb
ro.vendor.have_aeev_feature=0
ro.vendor.aee.convert64=0
ro.vendor.mtk_nn.option=A,B,C,D,E,F,G,Z
ro.vendor.mtk_nn_quant_preferred=1
ro.vendor.mtk_nn_support=1
ro.vendor.mtk_nn_baseline_support=1
ro.vendor.mtk_prefer_64bit_proc=1
ro.vendor.mtk_mipc_support=1
ro.vendor.mtk_mobile_management=1
persist.vendor.factory.GB2312=yes
ro.vendor.mtk_fast_charging_support=1
ro.vendor.mtk.sensor.support=yes
ro.vendor.mtk_tee_gp_support=1
ro.vendor.mtk_vgo_support=1
ro.vendor.efuse_writer_enable=1
